# CachetaBuraco - Git ignore

# Temporary scripts and one-off tools
*.py
scripts/
tools/

# Local plans, notes and generated reports
tasks
*.plan.md
*-plan.md
reports/

# Android / Gradle build outputs
build/
*/build/
out/
dist/
.gradle/
**/.gradle/
.kotlin/

# Android Studio / IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
.trunk/

# Local SDK / machine config
local.properties

# Logs and temporary files
*.log
*.bak
*.tmp
*_backup.kt

# Archives and generated packages
*.rar
*.zip
*.7z
*.apk
*.aab

# Credentials and signing files
*.jks
*.keystore
*.p12
*.pfx
*.env
.env
.env.*
!.env.example
!*.env.example
credentials/
secrets/

# Coverage and test artifacts
coverage/
*.exec

# System files
.DS_Store
Thumbs.db
desktop.ini
